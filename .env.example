# ============================================================
# LLM-Java-SVR-Benchmark — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to the repository.
# ============================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# --- Ollama (Llama 3.2 local server) ---
# Start with: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- RepairLLaMA ---
# Clone from: https://github.com/assert-kth/repairllama
REPAIRLLAMA_ROOT=/path/to/repairllama
REPAIRLLAMA_MODEL_ID=assert-kth/repairllama-CodeLlama-7b-java

# --- RAP-Gen ---
# Clone from: https://github.com/zimin9/RAP-Gen
RAPGEN_ROOT=/path/to/RAP-Gen
RAPGEN_MODEL_ID=Salesforce/codet5-large
RAPGEN_CHECKPOINT=/path/to/rapgen/checkpoint   # optional fine-tuned weights

# --- CVEfixes Corpus (for RAG) ---
# Download from: https://zenodo.org/record/7029359
CVEFIXES_DB=/path/to/CVEfixes.db

# --- Validation Tools ---
# CodeQL CLI: https://github.com/github/codeql-cli-binaries
# Snyk CLI:   npm install -g snyk && snyk auth
PROJECTS_ROOT=/path/to/java_projects_clones
CODEQL_DB_ROOT=/path/to/codeql_databases
